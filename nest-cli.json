{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/rastreador-precios/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/rastreador-precios/tsconfig.app.json"
  },
  "projects": {
    "rastreador-precios": {
      "type": "application",
      "root": "apps/rastreador-precios",
      "entryFile": "main",
      "sourceRoot": "apps/rastreador-precios/src",
      "compilerOptions": {
        "tsConfigPath": "apps/rastreador-precios/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "worker": {
      "type": "application",
      "root": "apps/worker",
      "entryFile": "main",
      "sourceRoot": "apps/worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/worker/tsconfig.app.json"
      }
    }
  },
  "monorepo": true,
  "root": "apps/rastreador-precios"
}